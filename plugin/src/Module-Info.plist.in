<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>English</string>
	<key>CFBundleExecutable</key>
	<string>@VW_BUNDLE_NAME@</string>
	<key>CFBundleIdentifier</key>
	<string>@VW_BUNDLE_ID@</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>@VW_BUNDLE_NAME@</string>
	<key>CFBundlePackageType</key>
	<string>BNDL</string>
	<key>CFBundleSignature</key>
	<string>VW12</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1.0</string>
	<key>CSResourcesFileMapped</key>
	<string>yes</string>
	<!-- ビルドの素性（CMake / CI が埋める）。どのビルドを入れているかを、
	     プラグインを起動しなくても確かめられるようにするため。 -->
	<!-- VWShellId は**この殻（プラグイン本体）の ID**。自動アップデートはこれを見て
	     「再起動が要るか」を決める——本体（.vwpayload）だけが新しいなら再起動は要らず、
	     殻まで変わっていれば要る。plugin/scripts/vw-probes-update.sh の
	     installed_shell と対。 -->
	<key>VWShellId</key>
	<string>@VW_SHELL_ID@</string>
	<!-- VWBuildId は**この殻を作ったときのビルド ID**。いま入っている本体の ID は
	     隣の VwSdkProbesPayload.build-info.txt にある（入れ替えで動くのは本体だけ）。 -->
	<key>VWBuildId</key>
	<string>@VW_BUILD_ID@</string>
	<key>VWBuildBranch</key>
	<string>@VW_BUILD_BRANCH@</string>
	<key>VWBuildCommit</key>
	<string>@VW_BUILD_VERSION@</string>
	<key>VWBuildTime</key>
	<string>@VW_BUILD_TIME@</string>
	<key>VWProbes</key>
	<string>@VW_PROBE_SUMMARY@</string>
</dict>
</plist>
